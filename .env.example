# ---------------------------------------------------------------------------
# wispcord — member bot environment
#
# Copy this file to `.env` and fill it in. On Wispbyte you can either paste
# these as environment variables in the panel or upload the .env file — the
# README covers both.
# ---------------------------------------------------------------------------

# REQUIRED. The MEMBER bot's own token, from the second Discord application.
# This is NOT the admin bot's token. The member bot will refuse to start
# without it.
MEMBER_BOT_TOKEN=

# The prefix members type before a command. Defaults to ">" if left blank.
COMMAND_PREFIX=>

# Public URL of the member page (your Cloudflare deployment), no trailing
# slash. The ticket panel builds `{MEMBER_SITE_URL}?open=support` from this.
# Example: https://your-site.pages.dev
MEMBER_SITE_URL=

# REQUIRED for the heartbeat. From Supabase → Project Settings → API.
#   SUPABASE_URL          the "Project URL"
#   SUPABASE_SERVICE_KEY  the "service_role" secret (NOT the anon key)
# The service key is server-side only — it is never sent to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
